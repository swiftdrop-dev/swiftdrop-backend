# Copy to .env for local use and fill in local values. Never commit .env.
DB_URL=jdbc:postgresql://localhost:5432/your_local_auth_database
DB_USERNAME=your_local_database_user
DB_PASSWORD=replace_with_local_database_password
# Generate a fresh key locally (for example, openssl rand -hex 32); do not use a shared value.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo accounts are initialized only when this is explicitly enabled:
# SPRING_PROFILES_ACTIVE=dev
