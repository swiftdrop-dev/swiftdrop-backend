SPRING_PROFILES_ACTIVE=local

# parcel-service Neon profile: set SPRING_PROFILES_ACTIVE=neon in its process.
# These variables must be exported; Spring Boot does not automatically load .env.
PGHOST=your-neon-host
PGDATABASE=neondb
PGUSER=your-database-user
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require

# parcel-service auth integration (set its active profile to demo before Neon)
# Use the M1 auth service's signing secret, never a committed demo secret.
JWT_SECRET=
JWT_ISSUER=swiftdrop
JWT_AUDIENCE=swiftdrop-api
FRONTEND_ORIGIN=http://localhost:5173
PRICING_BASE_URL=http://localhost:8083

# API Gateway
GATEWAY_PORT=8080

# Service ports
AUTH_SERVICE_PORT=8081
PARCEL_SERVICE_PORT=8082
PRICING_SERVICE_PORT=8083
MERCHANT_SERVICE_PORT=8084
DISPATCH_SERVICE_PORT=8085
COURIER_SERVICE_PORT=8086
TRACKING_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
WEBHOOK_SERVICE_PORT=8089
REPORTING_SERVICE_PORT=8090
