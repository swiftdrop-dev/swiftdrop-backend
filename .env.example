# =============================================================================
# SwiftDrop System Environment Configuration (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# System Execution Profile & Gateway Core
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
PORT=8080

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# Generate strong key using: openssl rand -base64 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# AI Chatbot & Google Gemini Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Database Configuration (Neon PostgreSQL / Local Postgres)
# -----------------------------------------------------------------------------
PGHOST=your-neon-host.aws.neon.tech
PGPORT=5432
PGDATABASE=neondb
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGSSLMODE=require

# Auth Service
AUTH_DB_URL=jdbc:postgresql://your-neon-host.aws.neon.tech:5432/neondb?sslmode=require
AUTH_DB_USERNAME=your_db_user
AUTH_DB_PASSWORD=your_db_password

# Merchant Service
MERCHANT_DB_URL=jdbc:postgresql://your-neon-host.aws.neon.tech:5432/neondb?sslmode=require
MERCHANT_DB_USERNAME=your_db_user
MERCHANT_DB_PASSWORD=your_db_password

# Dispatch Service
DISPATCH_DB_URL=jdbc:postgresql://your-neon-host.aws.neon.tech:5432/neondb?sslmode=require
DISPATCH_DB_USERNAME=your_db_user
DISPATCH_DB_PASSWORD=your_db_password

# Parcel Service
PARCEL_DB_NAME=neondb
PARCEL_DB_USER=your_db_user
PARCEL_DB_PASSWORD=your_db_password

# Courier Service
COURIER_DB_NAME=neondb
COURIER_DB_USER=your_db_user
COURIER_DB_PASSWORD=your_db_password

# Pricing Service
PRICING_DB_URL=jdbc:postgresql://your-neon-host.aws.neon.tech:5432/neondb?sslmode=require
PRICING_DB_USERNAME=your_db_user
PRICING_DB_PASSWORD=your_db_password

# -----------------------------------------------------------------------------
# RabbitMQ Message Broker
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# -----------------------------------------------------------------------------
# Internal Downstream Service Host Overrides
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8081
PARCEL_SERVICE_URL=http://localhost:8082
PRICING_SERVICE_URL=http://localhost:8083
MERCHANT_SERVICE_URL=http://localhost:8084
DISPATCH_SERVICE_URL=http://localhost:8085
COURIER_SERVICE_URL=http://localhost:8086
