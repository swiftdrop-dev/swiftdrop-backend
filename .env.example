SPRING_PROFILES_ACTIVE=local

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PARCEL_SERVICE_PORT=8082
PRICING_SERVICE_PORT=8083
MERCHANT_SERVICE_PORT=8084
DISPATCH_SERVICE_PORT=8085
COURIER_SERVICE_PORT=8086
TRACKING_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
WEBHOOK_SERVICE_PORT=8089
REPORTING_SERVICE_PORT=8090

# -----------------------------------------------------------------------------
# Security & JWT
# -----------------------------------------------------------------------------
# Shared secret for signing and validating HMAC-SHA256 JWTs (at least 32 characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# AI Chatbot & Google Gemini Configuration
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# Database Configuration (Database-per-Service on Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Auth Service (auth_db)
AUTH_DB_URL=jdbc:postgresql://your-neon-host/auth_db?sslmode=require
AUTH_DB_USERNAME=your_auth_db_user
AUTH_DB_PASSWORD=your_auth_db_password

# Merchant Service (merchantdb)
MERCHANT_DB_URL=jdbc:postgresql://your-neon-host/merchantdb?sslmode=require
MERCHANT_DB_USERNAME=your_merchant_db_user
MERCHANT_DB_PASSWORD=your_merchant_db_password

# Dispatch Service (dispatcherdb)
DISPATCH_DB_URL=jdbc:postgresql://your-neon-host/dispatcherdb?sslmode=require
DISPATCH_DB_USERNAME=your_dispatch_db_user
DISPATCH_DB_PASSWORD=your_dispatch_db_password

# Parcel Service (parcel_db)
PGHOST=your-neon-host
PGPORT=5432
PGDATABASE=parcel_db
PGUSER=your_parcel_db_user
PGPASSWORD=your_parcel_db_password
PGSSLMODE=require

# Courier Service (courier_db)
COURIER_DB_NAME=courier_db
COURIER_DB_USER=your_courier_db_user
COURIER_DB_PASSWORD=your_courier_db_password

# -----------------------------------------------------------------------------
# RabbitMQ Message Broker
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# -----------------------------------------------------------------------------
# Cloudinary Configuration (Parcel Service)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
