
SPRING_PROFILES_ACTIVE=local

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
PARCEL_SERVICE_PORT=8082
PRICING_SERVICE_PORT=8083
MERCHANT_SERVICE_PORT=8084
DISPATCH_SERVICE_PORT=8085
COURIER_SERVICE_PORT=8086
TRACKING_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
WEBHOOK_SERVICE_PORT=8089
REPORTING_SERVICE_PORT=8090

# -----------------------------------------------------------------------------
# Cloudinary Configuration (Parcel Service)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# -----------------------------------------------------------------------------
# Neon PostgreSQL Database Configuration
# Each service owns its independent logical database in Neon.
# -----------------------------------------------------------------------------

# Merchant Service (merchantdb)
MERCHANT_DB_URL=jdbc:postgresql://your-neon-host/merchantdb?sslmode=require
MERCHANT_DB_USERNAME=your_merchant_db_user
MERCHANT_DB_PASSWORD=your_merchant_db_password
MERCHANT_FLYWAY_USER=your_merchant_migration_user
MERCHANT_FLYWAY_PASSWORD=your_merchant_migration_password

# Dispatch Service (dispatcherdb)
DISPATCH_DB_URL=jdbc:postgresql://your-neon-host/dispatcherdb?sslmode=require
DISPATCH_DB_USERNAME=your_dispatch_db_user
DISPATCH_DB_PASSWORD=your_dispatch_db_password
DISPATCH_FLYWAY_USER=your_dispatch_migration_user
DISPATCH_FLYWAY_PASSWORD=your_dispatch_migration_password

# -----------------------------------------------------------------------------
# RabbitMQ Message Broker
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# -----------------------------------------------------------------------------
# Security & JWT
# -----------------------------------------------------------------------------
JWT_SECRET=your_base64_encoded_256bit_jwt_secret_key_here
