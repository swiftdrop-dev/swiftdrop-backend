# SwiftDrop Environment Configuration Template

# Database Configuration (Neon Cloud PostgreSQL or Local)
PGHOST=ep-sparkling-smoke-bdghtf2s-pooler.c-8.us-east-2.aws.neon.tech
PGPORT=5432
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require
POSTGRES_PORT=5433

# Individual Microservice DB URLs (Optional overrides)
AUTH_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/auth_db?sslmode=${PGSSLMODE}&channel_binding=require
AUTH_DB_USERNAME=${PGUSER}
AUTH_DB_PASSWORD=${PGPASSWORD}

COURIER_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/courier_db?sslmode=${PGSSLMODE}&channel_binding=require
COURIER_DB_USERNAME=${PGUSER}
COURIER_DB_PASSWORD=${PGPASSWORD}

DISPATCH_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/dispatcherdb?sslmode=${PGSSLMODE}&channel_binding=require
DISPATCH_DB_USERNAME=${PGUSER}
DISPATCH_DB_PASSWORD=${PGPASSWORD}
DISPATCH_FLYWAY_USER=${PGUSER}
DISPATCH_FLYWAY_PASSWORD=${PGPASSWORD}

MERCHANT_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/merchantdb?sslmode=${PGSSLMODE}&channel_binding=require
MERCHANT_DB_USERNAME=${PGUSER}
MERCHANT_DB_PASSWORD=${PGPASSWORD}
MERCHANT_FLYWAY_USER=${PGUSER}
MERCHANT_FLYWAY_PASSWORD=${PGPASSWORD}

NOTIFICATION_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/notification_db?sslmode=${PGSSLMODE}&channel_binding=require
NOTIFICATION_DB_USERNAME=${PGUSER}
NOTIFICATION_DB_PASSWORD=${PGPASSWORD}

PARCEL_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/parcel_db?sslmode=${PGSSLMODE}&channel_binding=require
PARCEL_DB_USERNAME=${PGUSER}
PARCEL_DB_PASSWORD=${PGPASSWORD}

PRICING_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/pricing_db?sslmode=${PGSSLMODE}&channel_binding=require
PRICING_DB_USERNAME=${PGUSER}
PRICING_DB_PASSWORD=${PGPASSWORD}

TRACKING_DB_URL=jdbc:postgresql://${PGHOST}:${PGPORT}/tracking_db?sslmode=${PGSSLMODE}&channel_binding=require
TRACKING_DB_USERNAME=${PGUSER}
TRACKING_DB_PASSWORD=${PGPASSWORD}

# Message Broker Configuration
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672

# Gateway & Frontend Ports
GATEWAY_PORT=8079
FRONTEND_PORT=5173

# Security & JWT. Generate locally. Do not commit real values.
JWT_SECRET=

# Shared by dispatch-service and courier-service for scheduled eligibility reads. Generate locally.
DISPATCH_SERVICE_TOKEN=
PARCEL_OTP_HMAC_SECRET=

# Google OAuth 2.0 (Frontend GIS Popup + Backend JWKS verification, no client secret required)
GOOGLE_CLIENT_ID=
GOOGLE_VERIFY_ONLINE=true

# Gemini AI (for chatbot)
GEMINI_API_KEY=

# Merchant Webhook Secret Encryption Key (32-character AES key)
MERCHANT_WEBHOOK_ENCRYPTION_KEY=

# Cloudinary (Proof of Delivery Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
