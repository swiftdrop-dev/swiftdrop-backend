SPRING_PROFILES_ACTIVE=local

# API Gateway
GATEWAY_PORT=8080

# Service ports
AUTH_SERVICE_PORT=8081
PARCEL_SERVICE_PORT=8082
PRICING_SERVICE_PORT=8083
MERCHANT_SERVICE_PORT=8084
DISPATCH_SERVICE_PORT=8085
COURIER_SERVICE_PORT=8086
TRACKING_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
WEBHOOK_SERVICE_PORT=8089
REPORTING_SERVICE_PORT=8090

# Webhook PostgreSQL connection (real credentials belong only in .env)
PGHOST=your-postgres-host
PGPORT=5432
PGDATABASE=neondb
PGUSER=your-postgres-user
PGPASSWORD=replace-with-your-password
PGSSLMODE=require
PGCHANNELBINDING=require

# Local webhook profile only; unrelated to real merchant/user IDs
WEBHOOK_LOCAL_MERCHANT_ID=dev-nathasha
# Generate a random value of at least 32 characters in your ignored .env.
# Shared only with the local mock receiver; not a production merchant secret.
WEBHOOK_LOCAL_SIGNING_SECRET=
WEBHOOK_BROKER_ENABLED=false
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
